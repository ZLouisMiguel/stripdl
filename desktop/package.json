{
  "name": "strip-reader",
  "author": "ZLouisMiguel on github",
  "version": "0.3.1",
  "description": "Webtoon reader powered by strip",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "build-cli": "cd .. && python build_cli.py",
    "build:win": "npm run build-cli && electron-vite build && electron-builder --win",
    "build:mac": "npm run build-cli && electron-vite build && electron-builder --mac",
    "build:linux": "npm run build-cli && electron-vite build && electron-builder --linux",
    "dist": "npm run build-cli && electron-vite build && electron-builder"
  },
  "build": {
    "appId": "com.strip.reader",
    "productName": "Strip",
    "icon": "renderer/public/icon",
    "files": [
      "out/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/strip-cli",
        "to": "strip-cli",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.entertainment"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "electron-vite": "^2.0.0",
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@rollup/plugin-commonjs": "^25.0.7"
  }
}
