{
  "name": "strip-reader",
  "author": {
    "name": "ZLouisMiguel",
    "email": "stripdl@users.noreply.github.com"
  },
  "version": "0.4.0",
  "description": "Webtoon reader powered by strip",
  "homepage": "https://github.com/ZLouisMiguel/stripdl",
  "main": "out/main/index.js",
  "scripts": {
    "test": "node --test",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "build-cli": "cd .. && python build_cli.py",
    "build:win": "npm run build-cli && electron-vite build && electron-builder --win",
    "build:mac": "npm run build-cli && electron-vite build && electron-builder --mac",
    "build:linux": "npm run build-cli && electron-vite build && electron-builder --linux",
    "dist": "npm run build-cli && electron-vite build && electron-builder"
  },
  "build": {
    "appId": "com.strip.reader",
    "productName": "Strip",
    "directories": {
      "buildResources": "installer",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/strip-cli",
        "to": "strip-cli",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "assets/strip.icns",
      "category": "public.app-category.entertainment",
      "artifactName": "Strip-${version}-macos-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/strip.ico",
      "artifactName": "Strip-${version}-windows-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icons",
      "category": "Graphics",
      "artifactName": "Strip-${version}-linux-${arch}.${ext}",
      "executableName": "strip-reader",
      "description": "Download and read comics offline with Strip.",
      "synopsis": "Offline comic downloader and reader",
      "maintainer": "Strip maintainers <stripdl@users.noreply.github.com>",
      "desktop": {
        "StartupNotify": "true",
        "X-GNOME-UsesNotifications": "true"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Strip",
      "installerIcon": "assets/strip.ico",
      "uninstallerIcon": "assets/strip.ico",
      "installerSidebar": "assets/windows/sidebar.bmp",
      "installerHeader": "assets/windows/header.bmp",
      "uninstallerSidebar": "assets/windows/uninstaller-sidebar.bmp",
      "include": "assets/windows/installer.nsh"
    },
    "dmg": {
      "background": "installer/assets/macos/dmg-background.png",
      "icon": "assets/strip.icns",
      "window": {
        "width": 900,
        "height": 600
      },
      "contents": [
        {
          "x": 260,
          "y": 300,
          "type": "file"
        },
        {
          "x": 640,
          "y": 300,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "iconSize": 128,
      "iconTextSize": 14,
      "title": "Strip ${version}"
    }
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "electron-vite": "^2.0.0",
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@rollup/plugin-commonjs": "^25.0.7"
  }
}
